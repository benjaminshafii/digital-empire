{
  "name": "@digital-empire/obsidian-collab",
  "version": "0.1.0",
  "description": "Notion-like collaboration for Obsidian via CRDT (Yjs)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "install:vault": "bash scripts/install-to-vault.sh",
    "install:hello-test": "bash scripts/install-to-vault.sh \"/Users/benjaminshafii/Documents/hello/test\""
  },
  "keywords": [
    "obsidian",
    "collaboration",
    "crdt",
    "yjs"
  ],
  "author": "Benjamin Shafii",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/state": "^6.5.3",
    "@codemirror/view": "^6.39.8",
    "y-codemirror.next": "^0.3.5",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29"
  }
