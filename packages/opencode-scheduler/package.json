{
  "name": "opencode-scheduler",
  "version": "0.1.0",
  "description": "OpenCode plugin for scheduling recurring jobs (launchd/systemd)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "scheduler",
    "cron",
    "launchd",
    "systemd",
    "plugin",
    "automation"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.1.3",
    "@types/bun": "^1.3.1",
    "typescript": "^5.9.3"
  }
}
