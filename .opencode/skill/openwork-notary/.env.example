# Optional: you can set these as env vars instead of Keychain.
# If unset, scripts will try to read from macOS Keychain.

APPLE_NOTARY_API_ISSUER_ID=
APPLE_NOTARY_API_KEY_ID=
APPLE_NOTARY_API_KEY_PATH=

# Optional: signing identity for local builds (not required for notarization submit)
APPLE_SIGNING_IDENTITY=
